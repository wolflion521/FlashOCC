              "view_overlap": ["Overlapping FOV", "Non-Overlapping FOV"]
            },
            "multi_modal_fusion": {
              "stage": ["Early Fusion", "Late Fusion", "Mid-Fusion"],
              "technique": ["Concatenation", "Summation", "Cross-Attention", "Dynamic Fusion"],
              "adaptive_mechanism": ["Learnable Weights", "Squeeze-and-Excitation", "KNN-Guided"]
            }
          },
          "temporal_fusion": {
            "alignment_method": ["Pose-Based Warping", "Flow-Based", "Attention-Based"],
            "fusion_mechanism": ["3D Convolution", "Cross-Attention", "Adaptive Mixing", "Concatenation + Conv"],
            "historical_frames": ["Single Previous Frame", "Multiple Frames", "Sliding Window"]
          }
