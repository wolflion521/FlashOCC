          "cross_attention": {
            "attention_type": ["Vanilla Cross-Attention", "Deformable Attention", "Sparse Attention"],
            "query_source": ["Voxel Features", "Learned Queries"],
            "key_value_source": ["2D Image Features", "Multi-Scale Features"]
          }
        }
      },
      
      "information_fusion": {
        "definition": "How multi-source information is integrated",
        "temporal_scope": ["Spatial Only", "Temporal Only", "Spatio-Temporal"],
        "modalities": {
