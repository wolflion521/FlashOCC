      }
    },
    
    "quick_reference_card": {
      "modality_first_approach": "First identify if LiDAR/Vision/Multi-modal → determines data pipeline",
      "view_representation_key": "Volumetric=full 3D, BEV=2D+height channels, TPV=3 orthogonal planes",
      "transformation_rule": "Vision methods must have 2D-to-3D transform; LiDAR methods need sparse-to-dense",
      "fusion_hierarchy": "Spatial fusion (multi-camera) → Temporal fusion (multi-frame) → Modal fusion (sensor)",
