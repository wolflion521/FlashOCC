      },
      
      "training_strategy": {
        "definition": "Supervision and optimization approach",
        "supervision_type": {
          "enumeration": [
            "Strong Supervision",
            "Weak Supervision", 
            "Semi-Supervision",
            "Self-Supervision"
          ],
          "details": {
