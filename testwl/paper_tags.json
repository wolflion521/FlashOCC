{
  
  "classification_framework": {
    "description": "Comprehensive classification framework for 3D occupancy perception algorithms in autonomous driving, extracted from survey 'A Survey on Occupancy Perception for Autonomous Driving: The Information Fusion Perspective'",
    "hierarchy": {
      "Domain": "Domain",
      "Input Modality": "Input Modality",
      "Core Pipeline": "Core Pipeline",
      "Component Design": "Component Design",
      "Implementation Details": "Implementation Details"
    },
    "classification_dimensions": {
      "input_modality": {
        "definition": "Primary sensor data source used by the algorithm",
        "enumeration": [
          "LiDAR-Centric",
          "Vision-Centric (Camera)",
          "Radar-Centric",
          "Multi-Modal"
        ],
        "sub_categories": {
          "vision_centric": {
            "camera_setup": ["Monocular", "Multi-Camera", "Stereo"],
            "image_type": ["RGB", "RGB-D"],
            "temporal_input": ["Single-Frame", "Multi-Frame"]
          },
          "lidar_centric": {
            "point_cloud_density": ["Sparse", "Dense"],
            "temporal_input": ["Single-Sweep", "Multi-Sweep"]
          },
          "multi_modal": {
            "modality_combination": [
              "Camera + LiDAR",
              "Camera + Radar",
              "Camera + LiDAR + Radar",
              "Camera + Text + LiDAR"
            ]
          }
        }
      },
      
      "network_architecture": {
        "definition": "Overall structural design of the neural network",
        "enumeration": [
          "CNN-Based",
          "Transformer-Based",
          "Hybrid CNN-Transformer",
          "NeRF-Based",
          "Gaussian-Based"
        ],
        "sub_categories": {
