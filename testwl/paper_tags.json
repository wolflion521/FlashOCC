        "downstream_application": ["evaluation_metrics", "temporal_modeling"]
      },
      "mutual_exclusivity": {
        "view_representation": ["Volumetric", "BEV", "TPV", "PV"],
        "supervision_type": ["Strong Supervision", "Weak Supervision", "Semi-Supervision", "Self-Supervision"]
