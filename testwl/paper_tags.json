            },
            "semi_supervision": {
              "label_coverage": ["Partial Scene", "Sparse Voxels", "Ray-Level Labels"]
            },
            "self_supervision": {
              "consistency_type": ["Photometric Consistency", "Geometric Consistency", "Cross-View Consistency"],
              "auxiliary_task": ["Depth Estimation", "Pose Estimation", "Novel View Synthesis"]
            }
          }
        },
        "loss_functions": {
          "geometric_losses": ["BCE (Binary Cross-Entropy)", "Scale-Invariant Log Loss", "Soft-IoU Loss"],
          "semantic_losses": ["CE (Cross-Entropy)", "Lovasz-Softmax", "Focal Loss", "Frustum Proportion Loss", "Position Awareness Loss"],
          "combined_losses": ["Scene-Class Affinity Loss", "Mask Classification Loss"],
          "consistency_losses": ["Spatial Consistency", "Photometric Consistency", "Modality Alignment Loss"],
          "distillation_losses": ["KL Divergence", "Feature Distillation"]
        }
