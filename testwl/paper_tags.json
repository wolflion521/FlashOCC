        "application": {
          "occupancy_prediction": ["Binary Classification", "Semantic Classification", "Open-Vocabulary"],
          "geometry_output": ["Voxel Grid", "Gaussian Representation", "Implicit Function"],
          "additional_outputs": ["Flow Prediction", "Uncertainty Estimation"]
