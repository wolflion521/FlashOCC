          "encoder_decoder": {
            "dimensionality": ["2D Only", "3D Only", "2D+3D Dual Branch"],
            "convolution_type": ["Standard Conv", "Sparse Conv", "Deformable Conv"],
            "transformer_type": ["Standard Attention", "Deformable Attention", "Windowed Attention"]
          }
        }
      },
      
      "view_representation": {
        "definition": "Intermediate feature representation format used in the pipeline",
        "enumeration": [
          "Volumetric (3D Volume)",
          "BEV (Bird's-Eye-View)",
          "TPV (Tri-Perspective-View)",
          "PV (Perspective-View)",
          "Point-Based",
          "Sparse Representation"
        ],
        "sub_categories": {
          "volumetric": {
